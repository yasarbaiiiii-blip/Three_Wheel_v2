{
  "expo": {
    "name": "Rover Three Wheel",
    "slug": "rover-three-wheel-native",
    "scheme": "roverthreewheel",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "63e79af6-e534-48c3-9550-6ab6161e40bc"
      }
    },
    "android": {
      "package": "com.yasarrrrr.roverthreewheelnative",
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "buildArchs": ["arm64-v8a"]
          }
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.20.1"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.yasarrrrr.roverthreewheelnative"
    }
  }
}
